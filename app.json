{
  "expo": {
    "name": "Ruta Viva",
    "slug": "ruta-viva",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rutaviva",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.davewaves.rutaviva"
    },
    "android": {
      "package": "com.davewaves.rutaviva",
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Ruta Viva usa la cámara para guardar fotos de tu recorrido.",
          "photosPermission": "Ruta Viva necesita tu galería para elegir fotos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Ruta Viva usa tu ubicación para registrar dónde estás."
        }
      ],
      "expo-font",
      "expo-image",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
